{
  "name": "@jianxx/dsh-cc-bundle-shell",
  "version": "0.1.0",
  "description": "Claude Code shell-surface parity layer: hooks bridge, skill loader, agents presets, memory, CC commands, deferred tool search, worktree tools, microcompaction, coordinator mode",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": ["lib", "cordis.patch.yml"],
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jianxx/dsh-cc-plugins.git",
    "directory": "packages/bundle/cc-shell"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-rc.5"
  },
  "dependencies": {
    "@jianxx/dsh-cc-tools": "workspace:^",
    "@jianxx/dsh-cc-tool-search": "workspace:^",
    "@jianxx/dsh-cc-skill-loader": "workspace:^",
    "@jianxx/dsh-cc-claude-code-agents": "workspace:^",
    "@jianxx/dsh-cc-plugin-loader": "workspace:^",
    "@jianxx/dsh-cc-output-styles": "workspace:^",
    "@jianxx/dsh-cc-memory": "workspace:^",
    "@jianxx/dsh-cc-memory-consolidation": "workspace:^",
    "@jianxx/dsh-cc-mcp-client": "workspace:^",
    "@jianxx/dsh-cc-mcp-config": "workspace:^",
    "@jianxx/dsh-cc-compaction-micro": "workspace:^",
    "@jianxx/dsh-cc-coordinator": "workspace:^",
    "@jianxx/dsh-cc-tool-git-worktree": "workspace:^",
    "@jianxx/dsh-cc-command-cost": "workspace:^",
    "@jianxx/dsh-cc-command-export": "workspace:^",
    "@jianxx/dsh-cc-command-stats": "workspace:^",
    "@jianxx/dsh-cc-command-status": "workspace:^",
    "@jianxx/dsh-cc-command-doctor": "workspace:^",
    "@jianxx/dsh-cc-hooks-claude-code": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../../deepseek-harness/vendor/cordis",
