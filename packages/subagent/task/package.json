{
  "name": "@jianxx/dsh-cc-subagent-task",
  "description": "Claude Code-compatible Task tool: subagent_type dispatch over per-workspace .claude/agents definitions for the DeepSeek Harness",
  "version": "0.4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jianxx/dsh-cc.git",
    "directory": "packages/subagent/task"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./registry": {
      "types": "./lib/registry.d.ts",
      "default": "./lib/registry.js"
    },
    "./tool": {
      "types": "./lib/tool.d.ts",
      "default": "./lib/tool.js"
    },
    "./catalog": {
      "types": "./lib/catalog.d.ts",
      "default": "./lib/catalog.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-agent": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dependencies": {
    "@jianxx/dsh-cc-claude-code-agents": "workspace:^",
    "@jianxx/dsh-cc-memory": "workspace:^",
    "@jianxx/dsh-cc-model-aliases": "workspace:^",
    "@jianxx/dsh-cc-tools": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "link:../../../../deepseek-harness/vendor/schemastery",
    "@deepseek-ai/cordis": "link:../../../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-agent": "link:../../../../deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-invariants": "link:../../../../deepseek-harness/packages/runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-scope": "link:../../../../deepseek-harness/packages/core/scope",
    "@deepseek-ai/dsh-subagent": "link:../../../../deepseek-harness/packages/subagent/subagent",
    "@deepseek-ai/dsh-system-prompt": "link:../../../../deepseek-harness/packages/core/system-prompt",
    "@jianxx/dsh-cc-claude-code-agents": "workspace:^",
    "@jianxx/dsh-cc-memory": "workspace:^",
    "@jianxx/dsh-cc-model-aliases": "workspace:^",
    "@jianxx/dsh-cc-tools": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  }
}
